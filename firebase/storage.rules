rules_version = '2';

// CampusCare - Cloud Storage rules.
//
// Uploads live at reports/{uid}/{millis}.{ext}, so a user can only ever write
// into their own folder. The size and content-type checks are duplicated on the
// client for a friendly message, but enforced here because the client cannot
// be trusted.
service firebase.storage {
  match /b/{bucket}/o {
    match /reports/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
